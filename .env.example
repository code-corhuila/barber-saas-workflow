# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# Empty DATABASE_URL: in-memory saga store (no database needed to try the HTTP contract).
DATABASE_URL=jdbc:postgresql://localhost:5432/barbersaas
DATABASE_USER=workflow_app
DATABASE_PASSWORD=
# The PEM public key every service validates with; barber-saas-infra-postgres/scripts/dev-keys.sh writes it.
JWT_PUBLIC_KEY=
# This service's own token, sub barber-saas-workflow: WORKFLOW_SERVICE_TOKEN of barber-saas-infra-postgres.
SERVICE_TOKEN=
BARBERSHOP_API_URL=http://localhost:8081
IDENTITY_AUTH_API_URL=http://localhost:8082
PARTICIPANT_TIMEOUT_MS=3000
PARTICIPANT_MAX_ATTEMPTS=3
PARTICIPANT_BACKOFF_MS=200
SAGA_RECOVERY_AGE_SECONDS=120
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=5000
